// ==========================================
// PROCTOR SHIELD AI — Prisma Schema
// PostgreSQL · Prisma ORM
// ==========================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- USERS & ROLES ---

model Role {
  id          Int      @id @default(autoincrement())
  roleName    String   @unique @map("role_name")
  description String?
  users       User[]

  @@map("roles")
}

model User {
  id            String   @id @default(uuid())
  fullName      String   @map("full_name")
  email         String   @unique
  password      String
  googleId      String?  @unique @map("google_id")
  profileImage  String?  @map("profile_image")
  roleId        Int      @map("role_id")
  status        String   @default("active")
  isOnline      Boolean  @default(false) @map("is_online")
  lastSeenAt    DateTime? @map("last_seen_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")
  sessionVersion Int     @default(0) @map("session_version")

  role              Role               @relation(fields: [roleId], references: [id])
  subjects          Subject[]
  quizzes           Quiz[]
  studentQuizzes    StudentQuiz[]
  notifications     Notification[]
  activityLogs      ActivityLog[]
  userSubscriptions UserSubscription[]
  otpCodes          OtpCode[]
  gameProfile       StudentGameProfile?
  coinLedger        StudentCoinLedger[]

  @@map("users")
}

model OtpCode {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id")
  code      String
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("otp_codes")
}

// --- SUBJECT & EXAM MANAGEMENT ---

model Subject {
  id          Int      @id @default(autoincrement())
  teacherId   String   @map("teacher_id")
  subjectName String   @map("subject_name")
  subjectCode String   @unique @map("subject_code")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  teacher User   @relation(fields: [teacherId], references: [id])
  quizzes Quiz[]

  @@map("subjects")
}

model Quiz {
  id               Int      @id @default(autoincrement())
  subjectId        Int      @map("subject_id")
  teacherId        String   @map("teacher_id")
  title            String
  description      String?
  accessCode       String?  @unique @map("access_code")
  isAiGenerated    Boolean  @default(false) @map("is_ai_generated")
  isGamified       Boolean  @default(true) @map("is_gamified")
  sourceFilePath   String?  @map("source_file_path")
  quizType         String?  @map("quiz_type")
  duration         Int?
  totalQuestions   Int?     @map("total_questions")
  passingScore     Int?     @map("passing_score")
  shuffleQuestions Boolean  @default(false) @map("shuffle_questions")
  allowRetake      Boolean  @default(false) @map("allow_retake")
  quizStatus       String   @default("draft") @map("quiz_status")
  createdAt        DateTime @default(now()) @map("created_at")

  subject        Subject       @relation(fields: [subjectId], references: [id])
  teacher        User          @relation(fields: [teacherId], references: [id])
  questions      Question[]
  studentQuizzes StudentQuiz[]

  @@map("quizzes")
}

model Question {
  id           Int      @id @default(autoincrement())
  quizId       Int      @map("quiz_id")
  questionText String   @map("question_text")
  questionType String?  @map("question_type")
  points       Int      @default(1)
  createdAt    DateTime @default(now()) @map("created_at")

  quiz    Quiz     @relation(fields: [quizId], references: [id])
  choices Choice[]
  answers Answer[]

  @@map("questions")
}

model Choice {
  id         Int     @id @default(autoincrement())
  questionId Int     @map("question_id")
  choiceText String  @map("choice_text")
  isCorrect  Boolean @default(false) @map("is_correct")

  question Question @relation(fields: [questionId], references: [id])

  @@map("choices")
}

// --- STUDENT QUIZ FLOW ---

model StudentQuiz {
  id                  String   @id @default(uuid())
  studentId           String   @map("student_id")
  quizId              Int      @map("quiz_id")
  attemptNumber       Int      @default(1) @map("attempt_number")
  randomSeed          String?  @map("random_seed")
  startTime           DateTime? @map("start_time")
  endTime             DateTime? @map("end_time")
  score               Decimal?  @db.Decimal(5, 2)
  remarks             String?
  aiVerdict           String?  @map("ai_verdict")
  cheatingProbability Decimal? @map("cheating_probability") @db.Decimal(5, 2)
  quizStatus          String?  @map("quiz_status")
  deviceType          String?  @map("device_type")
  monitoringLevel     String?  @map("monitoring_level")
  deviceCapabilities  Json?    @map("device_capabilities")
  lastHeartbeatAt     DateTime? @map("last_heartbeat_at")
  createdAt           DateTime @default(now()) @map("created_at")

  student    User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  quiz       Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers    Answer[]
  violations Violation[]
  aiAnalysis AiAnalysis?

  @@unique([studentId, quizId, attemptNumber])
  @@index([quizId, quizStatus])
  @@map("student_quizzes")
}

model Answer {
  id            BigInt  @id @default(autoincrement())
  studentQuizId String  @map("student_quiz_id")
  questionId    Int     @map("question_id")
  answerText    String? @map("answer_text")
  isCorrect     Boolean? @map("is_correct")
  pointsEarned  Int?    @map("points_earned")

  studentQuiz StudentQuiz @relation(fields: [studentQuizId], references: [id], onDelete: Cascade)
  question    Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([studentQuizId, questionId])
  @@map("answers")
}

// --- AI PROCTORING SYSTEM ---

model Violation {
  id              BigInt    @id @default(autoincrement())
  studentQuizId   String    @map("student_quiz_id")
  violationType   String?   @map("violation_type")
  confidenceScore Decimal?  @map("confidence_score") @db.Decimal(5, 2)
  timestamp       DateTime
  durationSeconds Int?      @map("duration_seconds")
  screenshotPath  String?   @map("screenshot_path")
  createdAt       DateTime  @default(now()) @map("created_at")

  studentQuiz   StudentQuiz    @relation(fields: [studentQuizId], references: [id], onDelete: Cascade)
  evidenceFiles EvidenceFile[]

  @@map("violations")
}

model EvidenceFile {
  id          BigInt   @id @default(autoincrement())
  violationId BigInt   @map("violation_id")
  fileType    String?  @map("file_type")
  filePath    String   @map("file_path")
  uploadedAt  DateTime @default(now()) @map("uploaded_at")

  violation Violation @relation(fields: [violationId], references: [id], onDelete: Cascade)

  @@map("evidence_files")
}

model AiAnalysis {
  id                  Int      @id @default(autoincrement())
  studentQuizId       String   @unique @map("student_quiz_id")
  totalViolations     Int      @default(0) @map("total_violations")
  cheatingProbability Decimal? @map("cheating_probability") @db.Decimal(5, 2)
  riskLevel           String?  @map("risk_level")
  finalVerdict        String?  @map("final_verdict")
  aiExplanation       String?  @map("ai_explanation")
  analyzedAt          DateTime @default(now()) @map("analyzed_at")

  studentQuiz StudentQuiz @relation(fields: [studentQuizId], references: [id], onDelete: Cascade)

  @@map("ai_analysis")
}

// --- NOTIFICATIONS & LOGS ---

model Notification {
  id        BigInt   @id @default(autoincrement())
  userId    String   @map("user_id")
  title     String
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model ActivityLog {
  id        BigInt   @id @default(autoincrement())
  userId    String   @map("user_id")
  activity  String
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("activity_logs")
}

// --- SUBSCRIPTION SYSTEM ---

model SubscriptionPlan {
  id            Int      @id @default(autoincrement())
  planName      String   @map("plan_name")
  yearlyPrice   Decimal? @map("yearly_price") @db.Decimal(10, 2)
  features      String?
  durationDays  Int?     @map("duration_days")
  createdAt     DateTime @default(now()) @map("created_at")

  userSubscriptions UserSubscription[]

  @@map("subscription_plans")
}

model UserSubscription {
  id                 String  @id @default(uuid())
  userId             String  @map("user_id")
  planId             Int     @map("plan_id")
  startDate          DateTime @map("start_date") @db.Date
  endDate            DateTime @map("end_date") @db.Date
  paymentStatus      String?  @map("payment_status")
  subscriptionStatus String?  @map("subscription_status")

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan @relation(fields: [planId], references: [id])
  payments Payment[]

  @@unique([userId, planId])
  @@index([subscriptionStatus, endDate])
  @@map("user_subscriptions")
}

model StudentGameProfile {
  studentId        String   @id @map("student_id")
  coins            Int      @default(100)
  unlockedAvatars  String[] @default(["shield", "fox", "owl", "robot", "lightning", "rocket"]) @map("unlocked_avatars")
  equippedAvatar   String   @default("shield") @map("equipped_avatar")
  topOneWins       Int      @default(0) @map("top_one_wins")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("student_game_profiles")
}

model StudentCoinLedger {
  id         BigInt   @id @default(autoincrement())
  studentId  String   @map("student_id")
  sourceType String   @map("source_type")
  sourceId   String   @map("source_id")
  amount     Int
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, sourceType, sourceId])
  @@index([studentId, createdAt])
  @@map("student_coin_ledger")
}

model Payment {
  id                   String    @id @default(uuid())
  subscriptionId       String    @map("subscription_id")
  amount               Decimal   @db.Decimal(10, 2)
  paymentMethod        String?   @map("payment_method")
  paymentStatus        String?   @map("payment_status")
  transactionReference String?   @unique @map("transaction_reference")
  providerPaymentId    String?   @unique @map("provider_payment_id")
  refundedAmount       Decimal   @default(0) @map("refunded_amount") @db.Decimal(10, 2)
  refundedAt           DateTime? @map("refunded_at")
  paidAt               DateTime? @map("paid_at")

  subscription UserSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model WebhookEvent {
  id          String   @id @default(uuid())
  provider    String
  eventId     String   @unique @map("event_id")
  eventType   String   @map("event_type")
  processedAt DateTime @default(now()) @map("processed_at")

  @@index([provider, processedAt])
  @@map("webhook_events")
}

// --- SYSTEM SETTINGS ---

model Setting {
  id           Int      @id @default(autoincrement())
  settingKey   String   @unique @map("setting_key")
  settingValue String?  @map("setting_value")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("settings")
}
