# ============================================================
# ProctorShield AI — Environment Variables
# Copy this file to .env and fill in the values
# ============================================================

# ── DATABASE ─────────────────────────────────────────────────
# PostgreSQL connection string (Neon serverless recommended)
DATABASE_URL="postgresql://user:password@host:5432/proctorshield?sslmode=require"

# ── AUTHENTICATION ───────────────────────────────────────────
# REQUIRED: Secret key for signing JWT session tokens
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
NEXTAUTH_SECRET=""

# ── GOOGLE GEMINI AI ─────────────────────────────────────────
# API key for Gemini Vision (proctoring) and Gemini Flash (question generation)
# Get a free key from: https://aistudio.google.com/
GEMINI_API_KEY=""

# ── GOOGLE OAUTH ─────────────────────────────────────────────
# Client ID from Google Cloud Console (APIs & Services > Credentials)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# ── PUSHER WEBSOCKETS ────────────────────────────────────────
# Create a free Pusher Channels app at: https://pusher.com/
PUSHER_APP_ID=""
NEXT_PUBLIC_PUSHER_KEY=""
PUSHER_SECRET=""
NEXT_PUBLIC_PUSHER_CLUSTER="ap1"

# ── EMAIL (SMTP) ─────────────────────────────────────────────
# Gmail SMTP credentials for OTP emails
# For Gmail: use an App Password (not your regular password)
# https://support.google.com/accounts/answer/185833
SMTP_EMAIL=""
SMTP_PASSWORD=""

# ── PAYMONGO (PAYMENTS) ──────────────────────────────────────
# API keys for processing GCash/Card payments (from dashboard.paymongo.com)
PAYMONGO_SECRET_KEY=""
NEXT_PUBLIC_PAYMONGO_PUBLIC_KEY=""

# ── OPTIONAL ─────────────────────────────────────────────────
# Set to 'true' to run frontend-only mode (proxies API to localhost:5000)
# FRONTEND_ONLY="false"
