# ============================================================
# ProctorShield AI — Environment Variables
# Copy this file to .env and fill in the values
# ============================================================

# ── DATABASE ─────────────────────────────────────────────────
# PostgreSQL connection string (Neon serverless recommended)
DATABASE_URL="postgresql://user:password@host:5432/proctorshield?sslmode=require"
REDIS_URL="redis://localhost:6379"

# Private S3-compatible storage for proctoring evidence (AWS S3, MinIO, etc.)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="proctorshield-evidence"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_FORCE_PATH_STYLE="true"

# ── AUTHENTICATION ───────────────────────────────────────────
# REQUIRED: Secret key for signing JWT session tokens
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
NEXTAUTH_SECRET=""
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""
CRON_SECRET=""
# Optional development-only passwords for seeded demo accounts.
# If omitted, the seed generates random values that are not printed.
DEMO_STUDENT_PASSWORD=""
DEMO_TEACHER_PASSWORD=""
# Must remain false outside a disposable development database.
SEED_DEMO_DATA="false"

# ── GOOGLE GEMINI AI ─────────────────────────────────────────
# API key for Gemini Vision (proctoring) and Gemini Flash (question generation)
# Get a free key from: https://aistudio.google.com/
GEMINI_API_KEY=""

# ── GOOGLE OAUTH ─────────────────────────────────────────────
# Client ID from Google Cloud Console (APIs & Services > Credentials)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# ── PUSHER WEBSOCKETS ────────────────────────────────────────
# Create a free Pusher Channels app at: https://pusher.com/
PUSHER_APP_ID=""
NEXT_PUBLIC_PUSHER_KEY=""
PUSHER_SECRET=""
NEXT_PUBLIC_PUSHER_CLUSTER="ap1"

# ── EMAIL (SMTP) ─────────────────────────────────────────────
# Gmail SMTP credentials for OTP emails
# For Gmail: use an App Password (not your regular password)
# https://support.google.com/accounts/answer/185833
SMTP_EMAIL=""
SMTP_PASSWORD=""

# ── PAYMONGO (PAYMENTS) ──────────────────────────────────────
# API keys for processing GCash/Card payments (from dashboard.paymongo.com)
PAYMONGO_SECRET_KEY=""
# Dedicated signing secret shown when the PayMongo webhook endpoint is created
PAYMONGO_WEBHOOK_SECRET=""
NEXT_PUBLIC_PAYMONGO_PUBLIC_KEY=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── OPTIONAL ─────────────────────────────────────────────────
# Set to 'true' to run frontend-only mode (proxies API to localhost:5000)
# FRONTEND_ONLY="false"
