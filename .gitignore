# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/.data/

# next.js
/.next/
.next-frontend/
.next-backend/
frontend/
backend/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
debug.log
cloudflared*.log
.tmp-*
/.tmp-*/
/.tmp-audit/
/.tmp-teacher-browser/
/.tmp-device-test/

# Microsoft Office temporary lock files
~$*.docx

# generated document QA and extraction artifacts
/docs/_working/

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
